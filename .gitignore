# Gradle / ForgeGradle. The compiled jar inside build/libs is tracked anyway (see below),
# so a plain `git pull` always has a ready-to-install jar at the documented path.
build/
!build/
build/*
!build/libs/
build/libs/*
!build/libs/ScriptCraft-*.jar
run/
.gradle/
out/

# IDE
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
bin/

# Local verification workspace (dev-verify output only; sources are committed)
dev-verify/build/
# CI logs published on failure by .github/workflows/build.yml
ci-last-build.log
ci-build.log
ci-verify.log
